# Google AI Studio API key for Gemini (required for answers)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-api-key

# Name the access prompt asks for (required)
CREATOR_NAME=your-name

# Optional: secret for signing session cookies. If unset, it is derived from
# GEMINI_API_KEY and CREATOR_NAME, so changing either signs everyone out.
# AUTH_SECRET=a-long-random-string

# Optional: enables the document management endpoints (/index,
# /index-distributed, /embed, DELETE /documents/{id}); send it in the
# X-Admin-Token header. Leave unset to keep those endpoints disabled.
# ADMIN_TOKEN=a-long-random-string

# Optional: maximum upload size per file for the document endpoints, in MiB
# (default: 50)
# MAX_UPLOAD_MB=50

# Optional: a private Hugging Face dataset repo holding the built index
# (faiss.index and metadata.json). A server that starts with no index
# downloads it from there, so a deployment built from the repository has a
# library. Upload a locally built index with
# `python -m app.scripts.upload_index`. HF_TOKEN needs read access to the repo
# for the server, and write access for the upload.
# INDEX_REPO=your-name/philosearch-index
# HF_TOKEN=hf_...

# Optional: enable Ray for /index-distributed
# ENABLE_RAY=true
