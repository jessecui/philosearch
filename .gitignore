# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyc
.Python
venv/
env/
ENV/
.venv
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# backend specific
backend/uploads/

# vscode
.vscode
# Staging folder left by an interrupted index_texts run
backend/data/.staging_*/
backend/data/metadata.json.old

# Source texts are kept locally, not committed (the folder itself stays)
backend/texts/*
!backend/texts/.gitkeep
# The index stores every passage in full, so it isn't committed either;
# build it locally with: python -m app.scripts.index_texts
backend/data/faiss.index
backend/data/metadata.json
